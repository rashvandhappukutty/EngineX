# ==============================================================================
# EngineX — Application & Backend Configuration
# ==============================================================================
PROJECT_NAME="EngineX — Smart Campus Crisis Coordination Engine"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Database Configuration
DATABASE_URL="sqlite:///./enginex.db"

# CORS Allowed Origins (Comma separated string or JSON array)
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# ==============================================================================
# Frontend Client Configuration
# ==============================================================================
# Public API base endpoint used by Vite browser frontend (Do NOT place secrets here)
VITE_API_BASE_URL="http://127.0.0.1:8000/api/v1"

# ==============================================================================
# AI Integration Settings
# ==============================================================================
AI_SERVICE_URL="http://localhost:8001/ai"
AI_ENABLED=true
AI_TIMEOUT_SECONDS=3.0

# ==============================================================================
# NLU Provider Configuration
# ==============================================================================
# Select the Natural Language Understanding provider:
# Options:
#   - 'rule_based_fallback' (default): Zero-dependency deterministic rule-based extractor
#   - 'gemini': Google Gemini AI model via official google-genai SDK
#   - 'custom_llm': Custom injected LLM inference callable
#   - 'mock': Mock adapter for automated unit testing
AI_NLU_PROVIDER=rule_based_fallback

# ==============================================================================
# Google Gemini API Settings
# ==============================================================================
# Your Google AI Studio API key (Required if AI_NLU_PROVIDER=gemini)
# Obtain a key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# The Gemini model class to use for NLU extraction
# Default: gemini-2.5-flash (Supported models: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# Maximum time in seconds to wait for a Gemini response before triggering fallback
GEMINI_REQUEST_TIMEOUT=10.0
